let lang='en',season='summer',crop=null,disease=null,playing=false,hist=[...HIST_SEED];

(function(){
  const w=document.getElementById('langScroll');
  w.innerHTML=Object.entries(LANGS).map(([c,d])=>`<button class="lbtn${c==='en'?' sel':''}" onclick="setLang('${c}',this)">${d.flag} ${d.label}</button>`).join('');
  applyLang();
})();

function goTo(pg){
  document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
  const el=document.getElementById('page-'+pg);
  if(el){el.classList.add('active');window.scrollTo(0,0)}
  document.querySelectorAll('.ni').forEach(n=>n.classList.remove('active'));
  const m={home:'nav-home',alerts:'nav-alerts',history:'nav-history'};
  const k=Object.keys(m).find(k=>pg.includes(k));
  if(k)document.getElementById(m[k]).classList.add('active');
  if(pg==='history')renderHist();
}

function setLang(code,btn){
  lang=code;
  document.querySelectorAll('.lbtn').forEach(b=>b.classList.remove('sel'));
  btn.classList.add('sel');applyLang();
}
function applyLang(){
  const d=LANGS[lang].k;
  document.querySelectorAll('[data-key]').forEach(el=>{const v=d[el.dataset.key];if(v!==undefined)el.textContent=v});
}

function setSeason(s,el){season=s;crop=null;document.querySelectorAll('.chip').forEach(c=>c.classList.remove('active'));el.classList.add('active')}
function goToCrop(){goTo('crop');const g=document.getElementById('cropGrid');g.innerHTML=(CROPS[season]||CROPS.summer).map(c=>`<div class="citem" onclick="pickCrop('${c.n}',this)"><span>${c.e}</span><p>${c.n}</p></div>`).join('')}
function pickCrop(n,el){crop=n;document.querySelectorAll('.citem').forEach(c=>c.classList.remove('sel'));el.classList.add('sel')}
function goToUpload(){goTo('upload')}

function handleImg(e){
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=ev=>{const img=document.getElementById('prevImg');img.src=ev.target.result;img.style.display='block';document.querySelector('.iprev .iph').style.display='none'};
  r.readAsDataURL(f);
}

function runAnalysis(){
  goTo('processing');
  const pf=document.getElementById('pf');pf.style.animation='none';pf.offsetHeight;pf.style.animation='';
  setTimeout(()=>{
    disease=DISEASES[Math.floor(Math.random()*DISEASES.length)];
    renderResult(disease);
    hist.unshift({e:'🌱',crop:crop||'Unknown',disease:disease.name,sev:disease.sev,date:'Just now'});
    goTo('results');
  },2800);
}

function renderResult(d){
  document.getElementById('confVal').textContent=d.conf+'%';
  const arc=document.getElementById('confArc'),total=2*Math.PI*31,filled=(d.conf/100)*total;
  arc.setAttribute('stroke-dasharray',`${filled.toFixed(1)} ${(total-filled).toFixed(1)}`);
  document.getElementById('rDis').textContent=d.name;
  document.getElementById('rCrop').textContent=(crop||'Paddy')+' · '+cap(season)+' Season';
  const sl=d.sev==='high'?'🔴 High Severity':d.sev==='medium'?'🟡 Medium Severity':'🟢 Low Severity';
  document.getElementById('rBadges').innerHTML=`<div class="rbadge ${d.sev}">${sl}</div><div class="rbadge">⏱ Spreads in ${d.spread}</div><div class="rbadge">${d.treat?'✅ Treatable':'❌ Not Treatable'}</div>`;
  document.getElementById('expertBox').style.display=d.conf<60?'block':'none';
  renderTreat('organic',d);
}

function switchTreat(type,btn){
  document.querySelectorAll('.ttab').forEach(t=>t.classList.remove('active'));btn.classList.add('active');
  if(disease)renderTreat(type,disease);
}
function renderTreat(type,d){
  const steps=type==='organic'?d.organic:d.chemical;
  const isOrg=type==='organic';
  document.getElementById('tContent').innerHTML=steps.map((s,i)=>`<div class="tstep"><div class="tnum" style="${!isOrg?'background:linear-gradient(135deg,var(--teal3),var(--tealdk));box-shadow:0 2px 10px rgba(78,201,196,.3)':''}">${i+1}</div><div class="ttxt">${s}</div></div>`).join('');
}

function toggleTTS(btn){
  const w=document.getElementById('waveB');
  if(playing){window.speechSynthesis?.cancel();playing=false;btn.textContent='▶';w.classList.add('pause');return}
  if(!disease)return;
  const txt=`Diagnosis complete. Disease: ${disease.name}. Confidence: ${disease.conf}%. Severity: ${disease.sev}. Spreads in ${disease.spread}. ${disease.treat?'Treatable.':'Not treatable.'} Organic treatment: ${disease.organic[0]}`;
  if('speechSynthesis'in window){
    const u=new SpeechSynthesisUtterance(txt);
    u.lang=lang==='ta'?'ta-IN':lang==='hi'||lang==='mr'?'hi-IN':'en-IN';u.rate=0.88;
    u.onend=()=>{playing=false;btn.textContent='▶';w.classList.add('pause')};
    window.speechSynthesis.speak(u);playing=true;btn.textContent='⏸';w.classList.remove('pause');
  }
}

function renderHist(){
  const c=document.getElementById('histList');
  if(!hist.length){c.innerHTML=`<div class="empty"><span>📋</span><p>No diagnoses yet.<br>Start by scanning your crop!</p></div>`;return}
  c.innerHTML=hist.map(h=>`<div class="hcard"><div class="hico">${h.e}</div><div class="hbody"><h4>${h.crop}</h4><p>${h.disease}</p><small>${h.date}</small></div><div class="hbadge ${h.sev}">${cap(h.sev)}</div></div>`).join('');
}

function requestExpert(){alert('✅ Expert review requested!\nAn agronomist will SMS you within 24 hours.')}
function cap(s){return s.charAt(0).toUpperCase()+s.slice(1)}
</script>
