<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1.0,maximum-scale=1.0,user-scalable=no"/>
<title>CropDoc</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link href="https://fonts.googleapis.com/css2?family=Gilda+Display&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Noto+Sans+Tamil:wght@400;600&family=Noto+Sans+Devanagari:wght@400;600&family=Noto+Sans+Telugu:wght@400;600&family=Noto+Sans+Kannada:wght@400;600&family=Noto+Sans+Bengali:wght@400;600&family=Noto+Sans+Gujarati:wght@400;600&display=swap" rel="stylesheet"/>
<style>
:root{
  --bg:       #FAFFFE;
  --bg2:      #F4FDFB;
  --bg3:      #EEF9F6;
  --teal:     #A8EDEA;
  --teal2:    #7DDDD9;
  --teal3:    #4EC9C4;
  --tealdk:   #2A9D98;
  --tealtxt:  #1A6B68;
  --lilac:    #C77DFF;
  --lilac2:   #B05FEE;
  --lilac3:   #9333EA;
  --lilaclt:  #F3E8FF;
  --lilactxt: #6B21A8;
  --blush:    #FED6E3;
  --blush2:   #FBB6CE;
  --blush3:   #F472B6;
  --blushlt:  #FFF0F6;
  --blushtxt: #9D174D;
  --mint:     #D1FAE5;
  --sky:      #DBEAFE;
  --lemon:    #FEF9C3;
  --white:    #FFFFFF;
  --ink:      #1E1B2E;
  --ink2:     #3D3A52;
  --ink3:     #6B6880;
  --ink4:     #9995B0;
  --border:   rgba(168,237,234,.45);
  --borderl:  rgba(199,125,255,.2);
  --sh-teal:  0 8px 28px rgba(78,201,196,.22);
  --sh-lilac: 0 8px 28px rgba(199,125,255,.28);
  --sh-blush: 0 6px 20px rgba(244,114,182,.18);
  --sh-soft:  0 4px 20px rgba(30,27,46,.07);
  --sh-card:  0 2px 16px rgba(168,237,234,.3);
  --r:        22px;
  --r-sm:     14px;
  --r-xs:     9px;
  --fh:       'Gilda Display', Georgia, serif;
  --fb:       'Plus Jakarta Sans', sans-serif;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{font-size:16px;-webkit-text-size-adjust:100%}
body{
  font-family:var(--fb);
  background:var(--bg);
  color:var(--ink);
  min-height:100dvh;
  max-width:480px;
  margin:0 auto;
  overflow-x:hidden;
  position:relative;
}

/* ── BACKGROUND BLOBS ─────────────────────────────────── */
.blobs{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.blob{position:absolute;border-radius:50%;filter:blur(60px);animation:blobdrift 18s ease-in-out infinite alternate}
.bl1{width:340px;height:340px;background:rgba(168,237,234,.28);top:-100px;left:-80px;animation-delay:0s}
.bl2{width:260px;height:260px;background:rgba(254,214,227,.35);bottom:-80px;right:-60px;animation-delay:-7s}
.bl3{width:200px;height:200px;background:rgba(199,125,255,.14);top:40%;right:-50px;animation-delay:-13s}
.bl4{width:150px;height:150px;background:rgba(209,250,229,.4);bottom:25%;left:-30px;animation-delay:-4s}
.bl5{width:120px;height:120px;background:rgba(254,249,195,.5);top:20%;left:30%;animation-delay:-9s}
@keyframes blobdrift{0%{transform:translate(0,0) scale(1)}100%{transform:translate(20px,15px) scale(1.06)}}

/* ── PAGES ────────────────────────────────────────────── */
.page{display:none;min-height:100dvh;padding-bottom:92px;position:relative;z-index:1}
.page.active{display:block;animation:softrise .4s cubic-bezier(.16,1,.3,1)}
@keyframes softrise{from{opacity:0;transform:translateY(16px)}to{opacity:1;transform:translateY(0)}}

/* ── NAV BAR ──────────────────────────────────────────── */
.nav{
  position:fixed;bottom:0;left:50%;transform:translateX(-50%);
  width:100%;max-width:480px;z-index:200;
  background:rgba(250,255,254,.92);
  backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);
  border-top:1.5px solid rgba(168,237,234,.5);
  display:flex;justify-content:space-around;align-items:center;
  padding:10px 0 max(12px,env(safe-area-inset-bottom));
  box-shadow:0 -4px 24px rgba(168,237,234,.2);
}
.ni{
  display:flex;flex-direction:column;align-items:center;gap:3px;
  cursor:pointer;padding:5px 18px;border-radius:var(--r-sm);
  color:var(--ink4);font-size:.62rem;font-weight:600;
  letter-spacing:.03em;transition:all .22s;
  -webkit-tap-highlight-color:transparent;
}
.ni svg{width:21px;height:21px}
.ni.active{color:var(--lilac3)}
.ni-pip{
  width:18px;height:3px;border-radius:99px;
  background:linear-gradient(90deg,var(--lilac),var(--blush3));
  opacity:0;transform:scaleX(0);transition:all .25s;
}
.ni.active .ni-pip{opacity:1;transform:scaleX(1)}

/* ── HOME HERO ────────────────────────────────────────── */
.hero{
  position:relative;overflow:hidden;
  padding:52px 24px 44px;
  background:linear-gradient(160deg,#F0FFFE 0%,#FAF5FF 50%,#FFF0F8 100%);
}
.hero::after{
  content:'';position:absolute;bottom:-1px;left:0;right:0;height:40px;
  background:linear-gradient(to bottom,transparent,var(--bg));
}
/* petal ring decorations */
.pring{
  position:absolute;border-radius:50%;
  border:1.5px solid rgba(199,125,255,.15);
  pointer-events:none;
}
.pr1{width:220px;height:220px;top:-60px;right:-50px}
.pr2{width:150px;height:150px;top:-20px;right:-10px;border-color:rgba(168,237,234,.2)}
.pr3{width:80px;height:80px;top:20px;right:30px;border-color:rgba(244,114,182,.15)}

.brand{display:flex;align-items:center;gap:11px;margin-bottom:26px}
.brand-mark{
  width:48px;height:48px;border-radius:16px;
  background:linear-gradient(135deg,var(--teal),var(--lilac));
  display:flex;align-items:center;justify-content:center;
  font-size:1.5rem;flex-shrink:0;
  box-shadow:var(--sh-teal);
}
.brand-name{
  font-family:var(--fh);font-size:1.9rem;
  background:linear-gradient(135deg,var(--tealdk) 0%,var(--lilac2) 60%,var(--blush3) 100%);
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
  line-height:1;
}
.brand-sub{font-size:.6rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--ink4);margin-top:3px}

.hero-h{
  font-family:var(--fh);font-size:2.5rem;
  line-height:1.1;color:var(--ink);
  margin-bottom:10px;
}
.hero-h span{
  background:linear-gradient(135deg,var(--tealdk),var(--lilac2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.hero-p{font-size:.84rem;color:var(--ink3);line-height:1.65;max-width:280px;font-weight:400}
.hero-pill{
  display:inline-flex;align-items:center;gap:7px;
  margin-top:16px;
  background:linear-gradient(135deg,rgba(168,237,234,.4),rgba(199,125,255,.2));
  border:1.5px solid rgba(199,125,255,.3);
  border-radius:99px;padding:6px 16px;
  font-size:.7rem;font-weight:700;color:var(--lilac3);
  box-shadow:0 2px 12px rgba(199,125,255,.15);
}

/* ── SECTION LABEL ────────────────────────────────────── */
.slabel{
  font-size:.6rem;font-weight:700;letter-spacing:.12em;
  text-transform:uppercase;color:var(--tealdk);
  display:flex;align-items:center;gap:8px;
  padding:22px 20px 0;
}
.slabel::after{content:'';flex:1;height:1.5px;background:linear-gradient(90deg,rgba(168,237,234,.6),transparent)}

/* ── LANGUAGE SCROLL ──────────────────────────────────── */
.lscroll{display:flex;gap:8px;overflow-x:auto;padding:12px 20px 4px;scroll-snap-type:x mandatory}
.lscroll::-webkit-scrollbar{display:none}
.lbtn{
  flex-shrink:0;scroll-snap-align:start;
  padding:9px 16px;border-radius:var(--r-sm);
  border:1.5px solid rgba(168,237,234,.5);
  background:var(--white);color:var(--ink3);
  font-family:var(--fb);font-size:.78rem;font-weight:600;
  cursor:pointer;white-space:nowrap;transition:all .2s;
  box-shadow:var(--sh-soft);
  -webkit-tap-highlight-color:transparent;
}
.lbtn.sel{
  background:linear-gradient(135deg,rgba(168,237,234,.35),rgba(199,125,255,.15));
  border-color:rgba(199,125,255,.4);
  color:var(--lilac3);
  box-shadow:0 3px 14px rgba(199,125,255,.18);
}

/* ── ACTION CARDS ─────────────────────────────────────── */
.agrid{display:grid;grid-template-columns:1fr 1fr;gap:12px;padding:14px 20px 0}
.acard{
  border-radius:var(--r);padding:20px 16px;cursor:pointer;
  background:var(--white);border:1.5px solid var(--border);
  box-shadow:var(--sh-card);
  transition:all .22s cubic-bezier(.16,1,.3,1);
  -webkit-tap-highlight-color:transparent;position:relative;overflow:hidden;
}
.acard::before{
  content:'';position:absolute;top:-30px;right:-30px;
  width:90px;height:90px;border-radius:50%;opacity:.5;
  transition:all .3s;
}
.acard:active{transform:scale(.96)}
.acard.full{grid-column:1/-1}
.acard.teal-card{
  background:linear-gradient(145deg,#E8FFFE,#D0FAF8);
  border-color:rgba(78,201,196,.3);
}
.acard.teal-card::before{background:var(--teal)}
.acard.lilac-card{
  background:linear-gradient(145deg,#F8F0FF,#F0E4FF);
  border-color:rgba(199,125,255,.25);
}
.acard.lilac-card::before{background:var(--lilaclt)}
.acard.blush-card{
  background:linear-gradient(145deg,#FFF3F8,#FFE8F2);
  border-color:rgba(244,114,182,.2);
}
.acard.blush-card::before{background:var(--blush)}
.ac-arr{
  position:absolute;top:14px;right:14px;
  width:24px;height:24px;border-radius:50%;
  display:flex;align-items:center;justify-content:center;
  font-size:.75rem;
}
.acard.teal-card .ac-arr{background:rgba(78,201,196,.2);color:var(--tealdk)}
.acard.lilac-card .ac-arr{background:rgba(199,125,255,.2);color:var(--lilac3)}
.acard.blush-card .ac-arr{background:rgba(244,114,182,.18);color:var(--blushtxt)}
.ac-icon{font-size:1.7rem;display:block;margin-bottom:10px}
.ac-title{font-size:.88rem;font-weight:700}
.ac-desc{font-size:.7rem;margin-top:3px;line-height:1.45}
.acard.teal-card .ac-title{color:var(--tealtxt)}
.acard.teal-card .ac-desc{color:var(--tealdk);opacity:.8}
.acard.lilac-card .ac-title{color:var(--lilactxt)}
.acard.lilac-card .ac-desc{color:var(--lilac2);opacity:.8}
.acard.blush-card .ac-title{color:var(--blushtxt)}
.acard.blush-card .ac-desc{color:var(--blush3);opacity:.8}

/* ── PAGE HEADER ──────────────────────────────────────── */
.ph{
  display:flex;align-items:center;gap:12px;
  padding:16px 20px 8px;
  position:sticky;top:0;z-index:10;
  background:rgba(250,255,254,.92);
  backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);
  border-bottom:1.5px solid rgba(168,237,234,.35);
}
.ph h2{
  font-family:var(--fh);font-size:1.4rem;
  background:linear-gradient(135deg,var(--tealdk),var(--lilac2));
  -webkit-background-clip:text;-webkit-text-fill-color:transparent;
}
.bbtn{
  width:36px;height:36px;border-radius:50%;
  background:var(--white);border:1.5px solid rgba(168,237,234,.6);
  display:flex;align-items:center;justify-content:center;
  cursor:pointer;color:var(--ink2);font-size:1rem;flex-shrink:0;
  box-shadow:var(--sh-soft);transition:all .18s;
  -webkit-tap-highlight-color:transparent;
}
.bbtn:active{background:var(--teal);transform:scale(.9)}

/* ── STEP TRACK ───────────────────────────────────────── */
.strack{display:flex;align-items:center;gap:5px;padding:12px 20px 0}
.sd{height:5px;border-radius:99px;background:rgba(168,237,234,.4);transition:all .3s;flex:1}
.sd.done{background:var(--teal3)}
.sd.cur{background:linear-gradient(90deg,var(--lilac),var(--blush3));flex:2.2;box-shadow:0 2px 8px rgba(199,125,255,.3)}
.stxt{font-size:.64rem;color:var(--ink4);font-weight:600;margin-left:6px;white-space:nowrap}

/* ── SECTION HEAD ─────────────────────────────────────── */
.sh{font-family:var(--fh);font-size:1.2rem;color:var(--ink);padding:20px 20px 0}
.sn{font-size:.75rem;color:var(--ink3);padding:5px 20px 0;line-height:1.55;font-weight:400}

/* ── CHIPS ────────────────────────────────────────────── */
.chips{display:flex;gap:8px;flex-wrap:wrap;padding:14px 20px 0}
.chip{
  padding:9px 18px;border-radius:99px;
  border:1.5px solid rgba(168,237,234,.5);
  background:var(--white);font-size:.79rem;font-weight:600;
  cursor:pointer;color:var(--ink3);transition:all .2s;
  box-shadow:var(--sh-soft);-webkit-tap-highlight-color:transparent;
}
.chip.active{
  background:linear-gradient(135deg,var(--lilac),var(--blush3));
  border-color:transparent;color:#fff;
  box-shadow:var(--sh-lilac);
}

/* ── CROP GRID ────────────────────────────────────────── */
.cgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;padding:14px 20px 0}
.citem{
  background:var(--white);border:1.5px solid rgba(168,237,234,.45);
  border-radius:var(--r-sm);padding:14px 8px;
  text-align:center;cursor:pointer;box-shadow:var(--sh-soft);
  transition:all .2s;-webkit-tap-highlight-color:transparent;
}
.citem:active{transform:scale(.94)}
.citem.sel{
  background:linear-gradient(145deg,#F0FFFE,#E4F9F8);
  border-color:var(--teal3);
  box-shadow:0 4px 18px rgba(78,201,196,.25);
}
.citem span{font-size:1.7rem;display:block;margin-bottom:5px}
.citem p{font-size:.67rem;font-weight:700;color:var(--ink3)}
.citem.sel p{color:var(--tealtxt)}

/* ── UPLOAD ZONES ─────────────────────────────────────── */
.uzone{
  margin:16px 20px 0;
  border:2px dashed rgba(199,125,255,.3);
  border-radius:var(--r);
  background:linear-gradient(145deg,rgba(243,232,255,.3),rgba(168,237,234,.15));
  padding:34px 20px;text-align:center;
  cursor:pointer;transition:all .22s;
  -webkit-tap-highlight-color:transparent;
}
.uzone:active{border-color:var(--lilac);background:rgba(199,125,255,.08)}
.uz-ic{font-size:2.2rem;display:block;margin-bottom:10px}
.uzone h4{font-size:.9rem;font-weight:700;color:var(--ink2)}
.uzone p{font-size:.73rem;color:var(--ink3);margin-top:4px}
.orline{
  display:flex;align-items:center;gap:10px;
  font-size:.7rem;color:var(--ink4);font-weight:600;
  margin:14px 20px 0;
}
.orline::before,.orline::after{content:'';flex:1;height:1.5px;background:linear-gradient(90deg,rgba(168,237,234,.5),rgba(199,125,255,.3))}
.iprev{
  margin:16px 20px 0;border-radius:var(--r);
  height:175px;background:linear-gradient(145deg,#EEF9F6,#F5EEFF);
  border:1.5px solid rgba(168,237,234,.4);
  display:flex;align-items:center;justify-content:center;overflow:hidden;
}
.iprev img{width:100%;height:100%;object-fit:cover;display:none}
.iprev .iph{font-size:2.5rem;opacity:.3}

/* ── BUTTONS ──────────────────────────────────────────── */
.btn{
  display:block;width:calc(100% - 40px);
  margin:14px 20px 0;padding:15px;
  border:none;border-radius:var(--r-sm);
  font-family:var(--fb);font-size:.92rem;font-weight:700;
  letter-spacing:.02em;cursor:pointer;transition:all .2s;
  -webkit-tap-highlight-color:transparent;
}
.btn-lilac{
  background:linear-gradient(135deg,var(--lilac),var(--blush3));
  color:#fff;box-shadow:var(--sh-lilac);
}
.btn-lilac:active{transform:scale(.97);box-shadow:none}
.btn-teal{
  background:linear-gradient(135deg,var(--teal3),var(--tealdk));
  color:#fff;box-shadow:var(--sh-teal);
}
.btn-teal:active{transform:scale(.97)}
.btn-out{
  background:transparent;color:var(--lilac3);
  border:1.5px solid rgba(199,125,255,.4);
  box-shadow:none;
}
.btn-out:active{background:var(--lilaclt)}

/* ── PROCESSING ───────────────────────────────────────── */
.proc{
  display:flex;flex-direction:column;align-items:center;
  justify-content:center;min-height:80dvh;padding:40px;text-align:center;
}
.pring{width:90px;height:90px;position:relative;margin-bottom:24px}
.pring svg{width:100%;height:100%;animation:spinR 2.2s linear infinite}
@keyframes spinR{to{transform:rotate(360deg)}}
.pemoji{
  position:absolute;inset:0;display:flex;align-items:center;
  justify-content:center;font-size:2rem;
  animation:gentlepulse 1.6s ease-in-out infinite;
}
@keyframes gentlepulse{0%,100%{transform:scale(1)}50%{transform:scale(1.12)}}
.ptitle{font-family:var(--fh);font-size:1.5rem;color:var(--ink);margin-bottom:6px}
.psub{font-size:.8rem;color:var(--ink3)}
.ptrack{width:100%;height:6px;background:rgba(168,237,234,.3);border-radius:99px;margin-top:24px;overflow:hidden}
.pfill{height:100%;border-radius:99px;background:linear-gradient(90deg,var(--teal3),var(--lilac),var(--blush3));animation:pfup 2.6s ease forwards}
@keyframes pfup{from{width:0}to{width:93%}}

/* ── RESULT BANNER ────────────────────────────────────── */
.rbanner{
  margin:16px 20px 0;border-radius:var(--r);padding:24px;
  background:linear-gradient(145deg,#E4F9F8,#F0E8FF,#FFF0F8);
  border:1.5px solid rgba(168,237,234,.5);
  position:relative;overflow:hidden;
  box-shadow:0 6px 30px rgba(168,237,234,.3);
}
.rbanner::before{
  content:'';position:absolute;top:-40px;right:-40px;
  width:130px;height:130px;border-radius:50%;
  background:radial-gradient(circle,rgba(199,125,255,.15),transparent 65%);
}
.rbanner::after{
  content:'';position:absolute;bottom:-30px;left:-20px;
  width:100px;height:100px;border-radius:50%;
  background:radial-gradient(circle,rgba(168,237,234,.2),transparent 65%);
}
.cring{width:74px;height:74px;position:relative;margin-bottom:12px;display:inline-block}
.cring svg{width:100%;height:100%}
.cval{
  position:absolute;inset:0;display:flex;align-items:center;
  justify-content:center;font-size:1rem;font-weight:800;
  color:var(--lilac3);font-family:var(--fb);
}
.rdis{font-family:var(--fh);font-size:1.5rem;color:var(--ink);margin-bottom:4px;line-height:1.1}
.rcrop{font-size:.77rem;color:var(--tealdk);font-weight:600}
.rbadges{display:flex;flex-wrap:wrap;gap:7px;margin-top:14px}
.rbadge{
  padding:5px 13px;border-radius:99px;font-size:.68rem;font-weight:700;
  background:rgba(255,255,255,.7);color:var(--ink2);
  border:1.5px solid rgba(168,237,234,.5);
  backdrop-filter:blur(4px);
}
.rbadge.high{background:rgba(255,240,246,.8);color:var(--blushtxt);border-color:rgba(244,114,182,.3)}
.rbadge.med{background:rgba(254,249,195,.8);color:#713F12;border-color:rgba(253,224,71,.4)}
.rbadge.low{background:rgba(209,250,229,.8);color:#065F46;border-color:rgba(52,211,153,.35)}

/* ── AUDIO BAR ────────────────────────────────────────── */
.abar{
  margin:12px 20px 0;padding:14px 16px;
  display:flex;align-items:center;gap:12px;
  background:var(--white);border:1.5px solid rgba(168,237,234,.4);
  border-radius:var(--r-sm);box-shadow:var(--sh-soft);
}
.playbtn{
  width:42px;height:42px;border-radius:50%;
  background:linear-gradient(135deg,var(--lilac),var(--blush3));
  border:none;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:1.1rem;flex-shrink:0;
  box-shadow:var(--sh-lilac);-webkit-tap-highlight-color:transparent;
}
.wwrap{flex:1}
.wbars{display:flex;gap:3px;align-items:center;height:28px}
.wb{
  flex:1;border-radius:3px;
  background:linear-gradient(to top,var(--teal3),var(--lilac));
  animation:wv 1.1s ease-in-out infinite;
}
.wb:nth-child(2){animation-delay:.12s}.wb:nth-child(3){animation-delay:.24s}
.wb:nth-child(4){animation-delay:.36s}.wb:nth-child(5){animation-delay:.48s}
.wb:nth-child(6){animation-delay:.60s}.wb:nth-child(7){animation-delay:.72s}
.wb:nth-child(8){animation-delay:.84s}
@keyframes wv{0%,100%{height:4px;opacity:.5}50%{height:22px;opacity:1}}
.wbars.pause .wb{animation-play-state:paused}
.albl{font-size:.67rem;color:var(--ink4);font-weight:600;margin-top:3px}

/* ── TREATMENT TABS ───────────────────────────────────── */
.ttabs{
  display:flex;margin:18px 20px 0;
  background:rgba(168,237,234,.2);border-radius:var(--r-sm);
  padding:4px;border:1.5px solid rgba(168,237,234,.4);gap:0;
}
.ttab{
  flex:1;padding:10px;border-radius:11px;border:none;
  background:transparent;font-family:var(--fb);
  font-size:.8rem;font-weight:700;cursor:pointer;color:var(--ink3);transition:all .22s;
}
.ttab.active{
  background:linear-gradient(135deg,var(--lilac),var(--blush3));
  color:#fff;box-shadow:0 3px 14px rgba(199,125,255,.3);
}
.tsteps{padding:14px 20px 0}
.tstep{display:flex;gap:12px;margin-bottom:16px;animation:softrise .3s ease both}
.tstep:nth-child(1){animation-delay:.04s}.tstep:nth-child(2){animation-delay:.1s}
.tstep:nth-child(3){animation-delay:.16s}.tstep:nth-child(4){animation-delay:.22s}
.tnum{
  width:27px;height:27px;border-radius:50%;flex-shrink:0;margin-top:1px;
  display:flex;align-items:center;justify-content:center;
  font-size:.7rem;font-weight:800;color:#fff;
  background:linear-gradient(135deg,var(--lilac),var(--blush3));
  box-shadow:0 2px 10px rgba(199,125,255,.3);
}
.ttxt{font-size:.83rem;color:var(--ink3);line-height:1.65;font-weight:400}

/* ── EXPERT BOX ───────────────────────────────────────── */
.expbox{
